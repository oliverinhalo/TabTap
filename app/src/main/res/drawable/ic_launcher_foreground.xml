<?xml version="1.0" encoding="utf-8"?>
<!--
  The icon is a fragment of fretboard: six strings crossed by a fret and a marked note,
  which is what the app is about. Drawn as vectors so it is crisp at every density.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Nut -->
    <path
        android:fillColor="#4A5560"
        android:pathData="M30,30 h3 v48 h-3 z" />

    <!-- Frets, spacing narrowing towards the bridge -->
    <path android:fillColor="#2E353D" android:pathData="M48,30 h1.6 v48 h-1.6 z" />
    <path android:fillColor="#2E353D" android:pathData="M62,30 h1.6 v48 h-1.6 z" />
    <path android:fillColor="#2E353D" android:pathData="M73,30 h1.6 v48 h-1.6 z" />

    <!-- Six strings, thinner towards the top -->
    <path android:fillColor="#6B7784" android:pathData="M30,76 h50 v2.4 h-50 z" />
    <path android:fillColor="#6B7784" android:pathData="M30,66 h50 v2.1 h-50 z" />
    <path android:fillColor="#7A8694" android:pathData="M30,56 h50 v1.8 h-50 z" />
    <path android:fillColor="#7A8694" android:pathData="M30,47 h50 v1.5 h-50 z" />
    <path android:fillColor="#8A96A4" android:pathData="M30,38 h50 v1.2 h-50 z" />
    <path android:fillColor="#8A96A4" android:pathData="M30,30 h50 v1 h-50 z" />

    <!-- A tapped note, in the app's accent colour -->
    <path
        android:fillColor="#4CC2A8"
        android:pathData="M55.8,56.9 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0" />
</vector>
